[Unit]
Description=SCC10 Flask dashboard API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=scc10
Group=scc10
WorkingDirectory=/opt/scc10/app
EnvironmentFile=/etc/scc10/scc10-flask.env
ExecStart=/opt/scc10/venv/bin/gunicorn --workers 2 --bind 127.0.0.1:5000 --access-logfile - --error-logfile - 'flask_app:create_app()'
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/scc10

[Install]
WantedBy=multi-user.target
