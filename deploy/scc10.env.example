# Copie para /etc/scc10/scc10.env e substitua os valores de exemplo.
# Nunca coloque senha administrativa, token ou conteúdo do JSON aqui.
NODE_ENV=production
PORT=3001
HOST=127.0.0.1
SCC10_DB_PATH=/var/lib/scc10/scc10.sqlite
GOOGLE_SERVICE_ACCOUNT_FILE=/etc/scc10/credentials/ga4.json
SCC10_PROPERTY_ID=309943616
SCC10_PUBLIC_ORIGIN=https://scc10.exemplo.interno
