# Copie para /etc/scc10/scc10-flask.env e substitua os valores de exemplo.
# Nunca coloque senha administrativa, token ou conteúdo do JSON aqui.
FLASK_ENV=production
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_SECURE_COOKIE=true
SCC10_DB_PATH=/var/lib/scc10/scc10.sqlite
GOOGLE_SERVICE_ACCOUNT_FILE=/etc/scc10/credentials/ga4.json
SCC10_PROPERTY_ID=309943616
FLASK_SECRET_KEY=REPLACE_WITH_PRIVATE_RANDOM_VALUE
FLASK_ADMIN_PASSWORD_HASH=REPLACE_WITH_WERKZEUG_HASH
FLASK_ADMIN_SESSION_LIFETIME_SECONDS=3600
