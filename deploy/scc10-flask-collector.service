[Unit]
Description=SCC10 Flask realtime collector cycle
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=scc10
Group=scc10
WorkingDirectory=/opt/scc10/app
EnvironmentFile=/etc/scc10/scc10-flask.env
ExecStart=/opt/scc10/venv/bin/python run_flask_collector.py --once
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/scc10
