# Configuração Flask para substituir o proxy Node após homologação.
# Substitua scc10.exemplo.interno pelo DNS do container antes de ativar.
server {
    listen 80;
    server_name scc10.exemplo.interno;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name scc10.exemplo.interno;
    ssl_certificate /etc/scc10/tls/fullchain.pem;
    ssl_certificate_key /etc/scc10/tls/privkey.pem;

    add_header X-Content-Type-Options nosniff always;

    location / {
        proxy_pass http://127.0.0.1:5000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }

    location ~ /\. {
        return 404;
    }
}
