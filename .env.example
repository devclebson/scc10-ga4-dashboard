# Copie para .env somente no servidor. Nunca versione o arquivo .env.
PORT=3001
HOST=127.0.0.1
SCC10_DB_PATH=data/scc10.sqlite

# Opção recomendada: caminho para o JSON da Service Account fora do repositório.
GOOGLE_SERVICE_ACCOUNT_FILE=C:/caminho/seguro/scc10-ga4-service-account.json

# Alternativa: JSON completo em variável de ambiente protegida.
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Depois de testar a Service Account, o frontend poderá usar este ID sem login Google.
SCC10_PROPERTY_ID=
