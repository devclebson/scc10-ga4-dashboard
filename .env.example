# Configuração local carregada automaticamente pelo Flask e pelo coletor.
# Copie este arquivo para .env e ajuste o caminho da Service Account.
GOOGLE_SERVICE_ACCOUNT_FILE=C:\Users\<usuario>\AppData\Local\SCC10\secrets\ga4-service-account.json
SCC10_PROPERTY_ID=309943616
SCC10_DB_PATH=data\scc10.sqlite
SCC10_COLLECTOR_LOCK_PATH=data\scc10.sqlite.lock
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=false
FLASK_SECRET_KEY=gere-com-o-script-de-configuracao
FLASK_ADMIN_PASSWORD_HASH=gere-com-o-script-de-configuracao
FLASK_ADMIN_SESSION_LIFETIME_SECONDS=3600
COLLECTOR_INTERVAL=30
